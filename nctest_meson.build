# Define project
project(
    'nctest',
    ['fortran'],
    version: '0.0.1',
    default_options: ['buildtype=debugoptimized'],
    meson_version: '>=1.5.0'
)

# Add arguments
add_project_arguments(
    '-DRKSSP',
    '-DLINUX',
    '-DSLOPE5',
    language: 'fortran'
)

# Set up compiler
compiler_name = meson.get_compiler('fortran').get_id()
compiler = meson.get_compiler('fortran')
message('Using compiler', compiler_name)

# Define NetCDF dependencies
netcdf_dep = [
    dependency('netcdf', language: 'fortran'),
    dependency('netcdf', language: 'c')
]

# If not on TACC, run the following test script
if not hostname.contains('tacc.utexas.edu')
    compiler.run(
    '''
PROGRAM netCDF3Test
    USE NETCDF
    IMPLICIT NONE
    INTEGER :: IERR, NCID
    IERR = NF90_OPEN('test.nc', NF90_NOWRITE, NCID)
END PROGRAM ''' ,
    required: true,
    dependencies: netcdf_dep)
endif

# Add subdirectories containing necessary code
subdir('src')
subdir('nctest')

# Construct the executable
executable(
    'nctest',
    sources: ncfort_src + nctest_src,
    dependencies: netcdf_dep
    fortran_args: '',
    link_language: 'fortran'
)